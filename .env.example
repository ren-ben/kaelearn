# Copy this file to .env and fill it in. Never commit .env: it is gitignored, and the
# pre-commit hook in .githooks refuses it.
# Cloudflare dashboard: R2 > Manage API tokens > Create token (Object Read & Write, your
# bucket only). The account ID is on the R2 overview page. Bucket name and public URL are in
# kaelearn.json.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
