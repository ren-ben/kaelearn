#!/bin/sh
# The repo is public: refuse to commit any .env file (only .env.example), even one added with -f.
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '(^|/)\.env\.example$')
if [ -n "$bad" ]; then
  echo "refusing to commit secrets: $bad" >&2
  echo "unstage with: git rm --cached $bad" >&2
  exit 1
fi
